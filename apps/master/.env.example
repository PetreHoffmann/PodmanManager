MASTER_HOST=0.0.0.0
MASTER_PORT=8080
# SQLite file path (PostgreSQL is not supported in this version)
DATABASE_URL=file:./data/master.db
# 32 random bytes, base64 or hex: openssl rand -base64 32
MASTER_SECRET_KEY=
# Seconds
HEARTBEAT_INTERVAL=30
AGENT_TIMEOUT=5
# Consecutive failed checks before a host is marked offline
HEARTBEAT_FAILURES=3
# Set to "off" to disable the Docker Hub update check shown in the About dialog
#UPDATE_CHECK=on
# Hinter einem Reverse-Proxy, der den Host nicht durchreicht: oeffentliche Host-Namen (kommagetrennt, mit Port falls nicht 80/443)
#ALLOWED_ORIGINS=master.example.com
