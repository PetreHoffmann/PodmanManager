MASTER_HOST=0.0.0.0
MASTER_PORT=8080
DATABASE_URL=file:/var/lib/podmanmanager/master.db
# openssl rand -base64 32   (keep it secret; losing it makes stored agent tokens unreadable)
MASTER_SECRET_KEY=
HEARTBEAT_INTERVAL=30
AGENT_TIMEOUT=5
HEARTBEAT_FAILURES=3
# Set to "off" to disable the Docker Hub update check shown in the About dialog (e.g. isolated networks)
#UPDATE_CHECK=on
# Hinter einem Reverse-Proxy, der den Host nicht durchreicht: oeffentliche Host-Namen (kommagetrennt, mit Port falls nicht 80/443)
#ALLOWED_ORIGINS=master.example.com
# Proxy mit TLS-Inspektion: Firmen-CA (PEM) fuer ausgehende TLS-Verbindungen (z. B. Update-Pruefung)
#NODE_EXTRA_CA_CERTS=/etc/podmanmanager/corp-ca.pem
