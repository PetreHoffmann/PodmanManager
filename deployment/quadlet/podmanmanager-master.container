# PodmanManager Master als Quadlet (rootless).
# Ablegen unter ~/.config/containers/systemd/ (siehe README.md in diesem Ordner).
[Unit]
Description=PodmanManager Master
After=network-online.target
Wants=network-online.target

[Container]
# Host mit cgroup v1 (Start scheitert mit "mkdir /sys/fs/cgroup/...: permission denied", Exit-Code 126): Zeile aktivieren
# PodmanArgs=--cgroups=enabled
Image=docker.io/petrecalinoiu/podmanmanager-master:0.3.0
ContainerName=podmanmanager-master
# Master und Agent auf demselben Host: gemeinsames Netzwerk (podmanmanager.network mit ablegen),
# der Master erreicht den Agent dann unter http://podmanmanager-agent:9126
# Network=podmanmanager.network
PublishPort=8080:8080
Volume=podmanmanager-data.volume:/data
# Schluessel fuer die verschluesselten Agent-Tokens (einmal anlegen, nie aendern):
#   openssl rand -base64 32 | tr -d '\n' | podman secret create podmanmanager-key -
Secret=podmanmanager-key,type=env,target=MASTER_SECRET_KEY
# Eigenen Host ohne separaten Agent verwalten (Master greift direkt auf den Podman-Socket zu).
# Sicherheit: wer den Master kompromittiert, steuert die Container dieses Benutzers (siehe docs/security.md).
# Volume=%t/podman/podman.sock:/run/podman/podman.sock
# Environment=LOCAL_PODMAN_SOCKET=/run/podman/podman.sock
# UserNS=keep-id
# User=%U
# SecurityLabelDisable=true
Environment=HEARTBEAT_INTERVAL=30
Environment=AGENT_TIMEOUT=5
# Hinter einem Reverse-Proxy, der den Host nicht durchreicht (sonst "Invalid Server Actions request"):
# Environment=ALLOWED_ORIGINS=master.example.com
# Proxy mit TLS-Inspektion (About-Dialog zeigt SELF_SIGNED_CERT_IN_CHAIN): Firmen-CA einbinden, siehe README.md
# Volume=%h/.config/podmanmanager/corp-ca.pem:/etc/corp-ca.pem:ro,Z
# Environment=NODE_EXTRA_CA_CERTS=/etc/corp-ca.pem
# Taeglich eine Kopie der Datenbank in /data/backups, die neuesten N behalten (0 = aus):
# Environment=BACKUP_KEEP=7
# Update-Pruefung im About-Dialog abschalten (abgeschottete Netze):
# Environment=UPDATE_CHECK=off
# Automatische Updates (braucht :latest statt festem Tag, dazu podman-auto-update.timer):
# AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
